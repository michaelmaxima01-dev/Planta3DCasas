# Planta3D Casas — configuração para hospedagem Apache/LiteSpeed (Hostinger)
DirectoryIndex index.html
Options -Indexes

RewriteEngine On

# Para forçar HTTPS (depois que o SSL estiver ativo), tire o # das 2 linhas abaixo
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Qualquer caminho desconhecido abre o sistema
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache: arquivos com hash no nome ficam 1 ano; o index.html sempre é revalidado
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
